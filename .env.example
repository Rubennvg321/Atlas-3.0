# Database (lokaal of beheerde PostgreSQL in de EU)
DATABASE_URL=postgres://postgres@localhost:5432/atlas

# Auth.js — genereer met: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Komma-gescheiden lijst van e-mailadressen die mogen inloggen
AUTH_ALLOWED_EMAILS=
# Optioneel: alleen accounts van dit Google Workspace-domein
AUTH_ALLOWED_DOMAIN=stepsandstairs.nl

# Alleen lokaal: inloggen zonder Google (werkt nooit in productie)
AUTH_DEV_BYPASS=0
