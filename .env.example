# ---------------------------------------------------------------
# Database — kies ÉÉN van beide manieren
# ---------------------------------------------------------------
# A) Productie (Scaleway): losse velden, zie Managed Database → "Endpoint".
#    Het wachtwoord mag hier speciale tekens bevatten.
#PGHOST=
#PGPORT=
#PGUSER=atlas
#PGPASSWORD=
#PGDATABASE=rdb
# B) Lokaal: één URL
DATABASE_URL=postgres://postgres@localhost:5432/atlas

# ---------------------------------------------------------------
# Inloggen
# ---------------------------------------------------------------
# Adres van de app (productie: https://atlas.stepsandstairs.nl)
AUTH_URL=http://localhost:3000
# Geheime sleutel — genereer met: openssl rand -base64 32
AUTH_SECRET=
# Uit Google Cloud → Google Auth Platform → Klanten → Atlas web
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Komma-gescheiden lijst van e-mailadressen die mogen inloggen
AUTH_ALLOWED_EMAILS=
# Optioneel: alleen accounts van dit Google Workspace-domein
AUTH_ALLOWED_DOMAIN=stepsandstairs.nl

# Alleen lokaal: inloggen zonder Google (werkt nooit in productie)
AUTH_DEV_BYPASS=0
